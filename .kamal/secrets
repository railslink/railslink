# Kamal reads these from the deploy-time ENV (injected from the localvault at
# deploy — never committed with real values). Capture the values from
# `heroku config -a railslink` into the vault, then export before `kamal deploy`.
#   SECRET_KEY_BASE, SLACK_*, ROLLBAR_ACCESS_TOKEN  -> from Heroku config
#   DATABASE_URL   = postgres://postgres:$POSTGRES_PASSWORD@railslink-db:5432/railslink_production
#   POSTGRES_PASSWORD = generated for the new accessory (save to vault)
#   KAMAL_REGISTRY_PASSWORD = `gh auth token` (GHCR write:packages)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
SLACK_API_TOKEN=$SLACK_API_TOKEN
SLACK_SIGNIN_API_KEY=$SLACK_SIGNIN_API_KEY
SLACK_SIGNIN_API_SECRET=$SLACK_SIGNIN_API_SECRET
SLACK_TEAM=$SLACK_TEAM
SLACK_VERIFICATION_TOKEN=$SLACK_VERIFICATION_TOKEN
ROLLBAR_ACCESS_TOKEN=$ROLLBAR_ACCESS_TOKEN
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
